// Remunify schema - currently still the early provisional draft.
// Locked target model (history, email, joinedAt, User, FxRate): docs/database-design.md
// Next step: migrate this file to match the locked design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum PayPeriod {
  ANNUAL
  MONTHLY
}

model Employee {
  id             String           @id @default(cuid())
  employeeNumber String           @unique
  fullName       String
  country        String
  department     String
  designation    String
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  salary         Salary?

  @@index([fullName])
  @@index([country, department])
  @@index([status])
}

/// Target model allows multiple rows per employee (history); this draft is still 1:1 current-only.
model Salary {
  id            String    @id @default(cuid())
  employeeId    String    @unique
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Precise money - never float
  amount        Decimal   @db.Decimal(14, 2)
  /// ISO 4217 currency code
  currency      String    @db.Char(3)
  period        PayPeriod @default(ANNUAL)
  effectiveFrom DateTime  @db.Date
  updatedAt     DateTime  @updatedAt

  @@index([currency])
}
