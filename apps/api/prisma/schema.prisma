// Remunify locked v1 schema - docs/database-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HR
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum PayPeriod {
  ANNUAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(HR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id             String           @id @default(cuid())
  employeeNumber String           @unique
  fullName       String
  email          String           @unique
  joinedAt       DateTime         @db.Date
  country        String
  department     String
  designation    String
  status         EmploymentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  salaries       Salary[]

  @@index([fullName])
  @@index([email])
  @@index([country, department])
  @@index([status])
}

/// Multiple rows per employee. Current = latest effectiveFrom.
model Salary {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Precise money - never float
  amount        Decimal   @db.Decimal(14, 2)
  /// ISO 4217 currency code
  currency      String    @db.Char(3)
  period        PayPeriod @default(ANNUAL)
  effectiveFrom DateTime  @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([currency])
}

/// Fixed demo FX rates for labeled USD company totals (not live market data).
model FxRate {
  currency   String   @id @db.Char(3)
  usdPerUnit Decimal  @db.Decimal(18, 8)
  asOf       DateTime @db.Date
  updatedAt  DateTime @updatedAt
}
