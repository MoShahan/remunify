{
  "name": "remunify",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @remunify/web\" \"npm run dev -w @remunify/api\"",
    "dev:web": "npm run dev -w @remunify/web",
    "dev:api": "npm run dev -w @remunify/api",
    "build": "npm run build -w @remunify/web && npm run build -w @remunify/api",
    "lint": "npm run lint -w @remunify/web && npm run lint -w @remunify/api",
    "lint:web": "npm run lint -w @remunify/web",
    "lint:api": "npm run lint -w @remunify/api",
    "lint:fix": "npm run lint:fix -w @remunify/web && npm run lint:fix -w @remunify/api",
    "typecheck": "npm run typecheck -w @remunify/web && npm run typecheck -w @remunify/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test -w @remunify/web --if-present",
    "test:api": "npm run test -w @remunify/api --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:coverage:web": "npm run test:coverage -w @remunify/web --if-present",
    "test:coverage:api": "npm run test:coverage -w @remunify/api --if-present",
    "db:generate": "npm run db:generate -w @remunify/api",
    "db:migrate": "npm run db:migrate -w @remunify/api",
    "db:migrate:dev": "npm run db:migrate:dev -w @remunify/api",
    "db:seed": "npm run db:seed -w @remunify/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2"
  }
}
